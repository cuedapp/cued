# Bootstrap infrastructure only. Configure provider integrations inside Cued.
# Docker Compose database password. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cued:cued@127.0.0.1:5433/cued
# Generate with: openssl rand -base64 32
CUED_ENCRYPTION_KEY=
LOG_LEVEL=info
CUED_PORT=3000
CUED_IMAGE=ghcr.io/cuedapp/cued:latest
# Mount this host directory into Cued and the same content into Jellyfin.
CUED_STRM_HOST_PATH=./data/strm
# Runtime UID/GID for the Cued container. Check yours with: id -u; id -g
CUED_UID=1000
CUED_GID=1000

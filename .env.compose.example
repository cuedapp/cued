# Docker Compose installation. Copy this file to .env beside compose.yaml.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate with: openssl rand -base64 32
CUED_ENCRYPTION_KEY=
LOG_LEVEL=info

# Optional deployment settings
CUED_IMAGE=ghcr.io/cuedapp/cued:latest
CUED_PORT=3000
# Match the owner of the STRM host directory on Linux.
CUED_UID=1000
CUED_GID=1000

# Local development only: Next.js runs on the host and PostgreSQL runs in a
# separate Compose project. Production Cued containers are not touched.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=cued
POSTGRES_PORT=5434
DATABASE_URL=postgresql://cued:cued@127.0.0.1:5434/cued
# Generate with: openssl rand -base64 32
CUED_ENCRYPTION_KEY=
LOG_LEVEL=info
